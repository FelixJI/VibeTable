{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibetable.local/contracts/v2/workspace-version-policy.schema.json",
  "title": "VibeTable Workspace Version Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "policyRevision",
    "currentWriter",
    "writerCompatibility",
    "workspaceManifest",
    "snapshotPackage",
    "compatibilityCorpus"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.0"
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 1
    },
    "currentWriter": {
      "$ref": "#/$defs/currentWriter"
    },
    "writerCompatibility": {
      "$ref": "#/$defs/writerCompatibility"
    },
    "workspaceManifest": {
      "$ref": "#/$defs/workspaceManifest"
    },
    "snapshotPackage": {
      "$ref": "#/$defs/snapshotPackage"
    },
    "compatibilityCorpus": {
      "$ref": "#/$defs/compatibilityCorpus"
    }
  },
  "$defs": {
    "appVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "positiveFormat": {
      "type": "integer",
      "minimum": 1
    },
    "currentWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appVersion",
        "workspaceManifestFormat",
        "snapshotPackageFormat",
        "internalSnapshotManifestFormat"
      ],
      "properties": {
        "appVersion": {
          "$ref": "#/$defs/appVersion"
        },
        "workspaceManifestFormat": {
          "$ref": "#/$defs/positiveFormat"
        },
        "snapshotPackageFormat": {
          "$ref": "#/$defs/positiveFormat"
        },
        "internalSnapshotManifestFormat": {
          "$ref": "#/$defs/positiveFormat"
        }
      }
    },
    "acceptedWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "status"],
      "properties": {
        "appVersion": {
          "$ref": "#/$defs/appVersion"
        },
        "status": {
          "enum": ["current", "verified"]
        }
      }
    },
    "pendingWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "status", "compatibility"],
      "properties": {
        "appVersion": {
          "$ref": "#/$defs/appVersion"
        },
        "status": {
          "const": "pending"
        },
        "compatibility": {
          "const": "unverified"
        }
      }
    },
    "writerCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "verificationGate",
        "nMinusOneTarget",
        "accepted",
        "pending"
      ],
      "properties": {
        "window": {
          "const": "current-and-one-previous-formal-release"
        },
        "verificationGate": {
          "const": "disabled-until-packaged-runtime-evidence"
        },
        "nMinusOneTarget": {
          "$ref": "#/$defs/appVersion"
        },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/acceptedWriter"
          }
        },
        "pending": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pendingWriter"
          }
        }
      }
    },
    "workspaceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedFormat",
        "topologySchemaVersion",
        "businessSchemaVersion",
        "olderFormatDisposition",
        "newerFormatDisposition"
      ],
      "properties": {
        "supportedFormat": {
          "$ref": "#/$defs/positiveFormat"
        },
        "topologySchemaVersion": {
          "$ref": "#/$defs/positiveFormat"
        },
        "businessSchemaVersion": {
          "$ref": "#/$defs/positiveFormat"
        },
        "olderFormatDisposition": {
          "const": "reject-zero-write-no-automatic-migration"
        },
        "newerFormatDisposition": {
          "const": "reject-newer-zero-write"
        }
      }
    },
    "snapshotPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentFormat",
        "minimumSupportedFormat",
        "unsupportedFormatDisposition"
      ],
      "properties": {
        "currentFormat": {
          "$ref": "#/$defs/positiveFormat"
        },
        "minimumSupportedFormat": {
          "$ref": "#/$defs/positiveFormat"
        },
        "unsupportedFormatDisposition": {
          "const": "reject-zero-write"
        }
      }
    },
    "compatibilityCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationPolicy", "immutablePrefix"],
      "properties": {
        "mutationPolicy": {
          "const": "append-only"
        },
        "immutablePrefix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchorCommit",
            "path",
            "baselineCount",
            "formalReleaseCount"
          ],
          "properties": {
            "anchorCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "const": "contracts/v2/compatibility-corpus.json"
            },
            "baselineCount": {
              "type": "integer",
              "minimum": 0
            },
            "formalReleaseCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
