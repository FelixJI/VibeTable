{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibetable.local/contracts/v2/provider-lab-evidence.schema.json",
  "title": "VibeTable provider hardware-lab evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "provider",
    "sourceCommit",
    "sourceHash",
    "artifactHashes",
    "generatedAt",
    "expiresAt",
    "releaseEligible",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 3
    },
    "provider": {
      "enum": [
        "network",
        "registeredCloud",
        "userMarkedSync",
        "removable"
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseEligible": {
      "const": true
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "oracle",
          "timeoutSeconds",
          "result",
          "logSha256"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "const": "passed"
          },
          "logSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
