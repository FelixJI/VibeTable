    },
    "DataChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "topic",
        "eventId",
        "sequence",
        "occurredAt",
        "schemaRevision",
        "dataRevision",
        "changeSetId",
        "tableId",
        "recordIds",
        "operation"
      ],
      "properties": {
        "contractVersion": {"$ref": "#/$defs/ContractVersion"},
        "topic": {"const": "data.changed"},
        "eventId": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "occurredAt": {"type": "string", "format": "date-time"},
        "schemaRevision": {"type": "string", "minLength": 1},
        "dataRevision": {"type": "string", "minLength": 1},
        "changeSetId": {"type": ["string", "null"]},
        "tableId": {"type": "string", "minLength": 1},
        "recordIds": {
          "type": "array",
