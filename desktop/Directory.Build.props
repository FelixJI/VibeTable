<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <PlatformTarget>x64</PlatformTarget>
    <VibeTableVersionSourcePath>$(MSBuildThisFileDirectory)..\backend\_version.py</VibeTableVersionSourcePath>
    <VibeTableVersionSourceText>$([System.IO.File]::ReadAllText('$(VibeTableVersionSourcePath)'))</VibeTableVersionSourceText>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(VibeTableVersionSourceText), '__version__\s*=\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <Target Name="ValidateVibeTableVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Version)' == ''" Text="Unable to read VibeTable version from $(VibeTableVersionSourcePath)." />
  </Target>
</Project>
