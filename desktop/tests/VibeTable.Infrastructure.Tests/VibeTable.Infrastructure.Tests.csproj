<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Infrastructure includes real process/sidecar lifecycle boundaries. Its
       independent line and branch floors come from the central inventory. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>$(VibeTableInfrastructureCoverageInclude)</Include>
    <Threshold>$(VibeTableInfrastructureLineCoverageMinimum),$(VibeTableInfrastructureBranchCoverageMinimum)</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <Target Name="ValidateVibeTableInfrastructureCoverageProperties" BeforeTargets="VSTest"
          Condition="'$(CollectCoverage)' == 'true'">
    <Error Condition="'$(VibeTableInfrastructureCoverageInclude)' == '' or '$(VibeTableInfrastructureLineCoverageMinimum)' == '' or '$(VibeTableInfrastructureBranchCoverageMinimum)' == ''"
           Text="Infrastructure coverage properties must come from .ci/project.json via qa/next.py." />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Infrastructure\VibeTable.Infrastructure.csproj" />
  </ItemGroup>

</Project>
