<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Workspace owns persisted revisions and refs. Its independent line and
       branch floors come from the central coverage inventory. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>$(VibeTableWorkspaceCoverageInclude)</Include>
    <Threshold>$(VibeTableWorkspaceLineCoverageMinimum),$(VibeTableWorkspaceBranchCoverageMinimum)</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <Target Name="ValidateVibeTableWorkspaceCoverageProperties" BeforeTargets="VSTest"
          Condition="'$(CollectCoverage)' == 'true'">
    <Error Condition="'$(VibeTableWorkspaceCoverageInclude)' == '' or '$(VibeTableWorkspaceLineCoverageMinimum)' == '' or '$(VibeTableWorkspaceBranchCoverageMinimum)' == ''"
           Text="Workspace coverage properties must come from .ci/project.json via qa/next.py." />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Workspace\VibeTable.Workspace.csproj" />
  </ItemGroup>

  <!-- The old path-based adapter tests are retained in history only. The
       public module surface is the stream-based CompareAsync seam. -->
  <ItemGroup>
    <Compile Remove="DiffAdapterTests.cs" />
  </ItemGroup>

</Project>
