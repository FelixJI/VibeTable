<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Workspace owns persisted revisions and refs. Its independent line and
       branch floors come from the central coverage inventory. -->
  <PropertyGroup Condition="'$(VibeTableCoverageSettingsDirectory)' != ''">
    <RunSettingsFilePath>$(VibeTableCoverageSettingsDirectory)/$(MSBuildProjectName).runsettings</RunSettingsFilePath>
    <VSTestResultsDirectory>$(VibeTableCoverageResultsDirectory)/$(MSBuildProjectName)</VSTestResultsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Workspace\VibeTable.Workspace.csproj" />
  </ItemGroup>

  <!-- The old path-based adapter tests are retained in history only. The
       public module surface is the stream-based CompareAsync seam. -->
  <ItemGroup>
    <Compile Remove="DiffAdapterTests.cs" />
  </ItemGroup>

</Project>
