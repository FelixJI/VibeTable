<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- PreviewHost is a separate process/security boundary. Its executable
       coverage is measured independently from the Desktop composition host. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>[VibeTable.PreviewHost]*</Include>
    <SkipAutoProps>true</SkipAutoProps>
    <Threshold>$(VibeTablePreviewHostLineCoverageMinimum),$(VibeTablePreviewHostBranchCoverageMinimum)</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <Target Name="ValidatePreviewHostCoverageThresholds" BeforeTargets="VSTest"
          Condition="'$(CollectCoverage)' == 'true'">
    <Error Condition="'$(VibeTablePreviewHostLineCoverageMinimum)' == '' or '$(VibeTablePreviewHostBranchCoverageMinimum)' == ''"
           Text="PreviewHost line and branch coverage minimums must come from .ci/project.json via qa/next.py." />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Desktop\VibeTable.Desktop.csproj" />
    <ProjectReference Include="..\..\src\VibeTable.PreviewHost\VibeTable.PreviewHost.csproj" />
  </ItemGroup>

</Project>
