<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- OpenXml is measured independently from the Workspace dependency so
       neither assembly can hide the other's uncovered lines or branches. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>$(VibeTableDocumentDiffOpenXmlCoverageInclude)</Include>
    <Threshold>$(VibeTableDocumentDiffOpenXmlLineCoverageMinimum),$(VibeTableDocumentDiffOpenXmlBranchCoverageMinimum)</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <Target Name="ValidateVibeTableDocumentDiffOpenXmlCoverageProperties" BeforeTargets="VSTest"
          Condition="'$(CollectCoverage)' == 'true'">
    <Error Condition="'$(VibeTableDocumentDiffOpenXmlCoverageInclude)' == '' or '$(VibeTableDocumentDiffOpenXmlLineCoverageMinimum)' == '' or '$(VibeTableDocumentDiffOpenXmlBranchCoverageMinimum)' == ''"
           Text="DocumentDiff.OpenXml coverage properties must come from .ci/project.json via qa/next.py." />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.DocumentDiff.OpenXml\VibeTable.DocumentDiff.OpenXml.csproj" />
    <ProjectReference Include="..\..\src\VibeTable.Workspace\VibeTable.Workspace.csproj" />
  </ItemGroup>

</Project>
