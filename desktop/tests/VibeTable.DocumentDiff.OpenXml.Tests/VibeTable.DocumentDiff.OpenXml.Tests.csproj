<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- OpenXml is measured independently from the Workspace dependency so
       neither assembly can hide the other's uncovered lines or branches. -->
  <PropertyGroup Condition="'$(VibeTableCoverageSettingsDirectory)' != ''">
    <RunSettingsFilePath>$(VibeTableCoverageSettingsDirectory)/$(MSBuildProjectName).runsettings</RunSettingsFilePath>
    <VSTestResultsDirectory>$(VibeTableCoverageResultsDirectory)/$(MSBuildProjectName)</VSTestResultsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.DocumentDiff.OpenXml\VibeTable.DocumentDiff.OpenXml.csproj" />
    <ProjectReference Include="..\..\src\VibeTable.Workspace\VibeTable.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\Qualification\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Qualification\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
