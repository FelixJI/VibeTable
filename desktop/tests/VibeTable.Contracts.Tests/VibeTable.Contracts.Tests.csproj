<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>$(VibeTableContractsCoverageInclude)</Include>
    <ExcludeByFile>$(VibeTableContractsCoverageExcludeByFile)</ExcludeByFile>
    <Threshold>$(VibeTableContractsLineCoverageMinimum),$(VibeTableContractsBranchCoverageMinimum)</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <Target Name="ValidateVibeTableContractsCoverageProperties" BeforeTargets="VSTest"
          Condition="'$(CollectCoverage)' == 'true'">
    <Error Condition="'$(VibeTableContractsCoverageInclude)' == '' or '$(VibeTableContractsLineCoverageMinimum)' == '' or '$(VibeTableContractsBranchCoverageMinimum)' == '' or '$(VibeTableContractsCoverageExcludeByFile)' == ''"
           Text="Contracts coverage properties must come from .ci/project.json via qa/next.py." />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Contracts\VibeTable.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\tests\contract\fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fixtures\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
