<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      The test project targets net10.0-windows so it can reference the
      VibeTable.Desktop WPF project, but does NOT set UseWPF=true: the ViewModel
      and router tests do not touch any WPF control and we want the test
      host to spin up without dragging the WPF presentation stack in.
    -->
  </PropertyGroup>

  <!-- WPF windows and the WebView host are composition-heavy. Ratchet their
       current executable line coverage without counting transitive libraries,
       which have dedicated test projects and gates below. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>[VibeTable.Desktop]*,[VibeTable.PreviewHost]*</Include>
    <SkipAutoProps>true</SkipAutoProps>
    <Threshold>45</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Desktop\VibeTable.Desktop.csproj" />
    <ProjectReference Include="..\..\src\VibeTable.PreviewHost\VibeTable.PreviewHost.csproj" />
  </ItemGroup>

</Project>
