<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      The test project targets net10.0-windows so it can reference the
      VibeTable.Desktop WPF project, but does NOT set UseWPF=true: the ViewModel
      and router tests do not touch any WPF control and we want the test
      host to spin up without dragging the WPF presentation stack in.
    -->
  </PropertyGroup>

  <!-- WPF windows and the WebView host are composition-heavy. PreviewHost has
       its own test project and threshold, so neither assembly can hide the
       other's uncovered lines in a merged total. -->
  <PropertyGroup Condition="'$(VibeTableCoverageSettingsDirectory)' != ''">
    <RunSettingsFilePath>$(VibeTableCoverageSettingsDirectory)/$(MSBuildProjectName).runsettings</RunSettingsFilePath>
    <VSTestResultsDirectory>$(VibeTableCoverageResultsDirectory)/$(MSBuildProjectName)</VSTestResultsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeTable.Desktop\VibeTable.Desktop.csproj" />
    <ProjectReference Include="..\..\src\VibeTable.Workspace\VibeTable.Workspace.csproj" />
  </ItemGroup>

</Project>
