<Window x:Class="VibeTable.Desktop.DirectusStartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在准备 VibeTable" Height="590" Width="660"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F5F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17324D" Padding="30,24">
            <StackPanel>
                <TextBlock Text="正在准备本地数据服务" Foreground="White"
                           FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="StageTitleText" Text="准备运行环境"
                           Foreground="#D9E8F5" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="30,24,30,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="首次启动步骤" FontSize="13" FontWeight="SemiBold"
                           Foreground="#486276" Margin="0,0,0,10"/>
                <ListBox x:Name="StepsList" BorderThickness="0" Background="Transparent"
                         IsHitTestVisible="False" FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="DetailText" Text="正在检查本地运行目录…"
                           FontSize="15" TextWrapping="Wrap" Foreground="#243746"/>
                <TextBlock x:Name="ElapsedText" Text="已用时 0 秒"
                           Margin="0,8,0,14" Foreground="#718391"/>
                <ProgressBar x:Name="StageProgress" Height="8" IsIndeterminate="True"
                             Foreground="#2A7F9E" Background="#DDE5EC"/>

                <Expander Header="详细日志" Margin="0,20,0,0" IsExpanded="True"
                          Foreground="#486276">
                    <Border Margin="0,8,0,0" Background="#111C25" CornerRadius="4" Padding="10">
                        <TextBox x:Name="LogBox" Height="190" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" Foreground="#C9D8E3"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </Expander>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="30,0,30,22" LastChildFill="True">
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="#718391"
                       Text="首次安装可能需要几分钟，请保持网络连接。"/>
            <Button x:Name="ExitButton" DockPanel.Dock="Right" Content="退出"
                    Width="88" Height="32" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="OnExitClick"/>
            <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="重试"
                    Width="88" Height="32" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="OnRetryClick"/>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消"
                    Width="88" Height="32" Click="OnCancelClick"/>
        </DockPanel>
    </Grid>
</Window>
