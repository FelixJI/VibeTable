<Window x:Class="VibeTable.Desktop.DirectusLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeTable 登录" Icon="Assets/Brand/VibeTable.png" Height="430" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="登录 Directus" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,18"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="使用本地邮箱账号。凭据仅发送到本机 Python 会话代理。" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="邮箱" Margin="0,0,0,5"/>
        <TextBox x:Name="EmailBox" Grid.Row="3" Height="34" Padding="8,5"/>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="密码" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Padding="8,5"/>
            <TextBlock Text="一次性验证码（如账号已启用）" Margin="0,12,0,5"/>
            <TextBox x:Name="OtpBox" Height="34" Padding="8,5"/>
            <CheckBox x:Name="RememberPasswordBox" Margin="0,14,0,0"
                      Content="保存密码到 Windows 凭据管理器"
                      Checked="OnRememberChanged" Unchecked="OnRememberChanged"/>
            <CheckBox x:Name="AutoLoginBox" Margin="0,8,0,0"
                      Content="以后自动登录"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Margin="0,14,0,0"
                   Foreground="#ff8a80" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="88" Height="34" Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button x:Name="LoginButton" Content="登录" Width="100" Height="34"
                    IsDefault="True" Click="OnLoginClick"/>
        </StackPanel>
    </Grid>
</Window>
