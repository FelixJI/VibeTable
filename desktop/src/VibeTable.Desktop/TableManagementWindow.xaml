<Window x:Class="VibeTable.Desktop.TableManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表管理" Height="520" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="表管理" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="创建新表或删除已有用户表。系统表（directus_*、vibetable_document*、vibetable_workspace*）不可在此管理。"
                   TextWrapping="Wrap"/>

        <DockPanel Grid.Row="2" LastChildFill="True">
            <Button x:Name="NewTableButton" DockPanel.Dock="Top"
                    Content="+ 新建表" Click="OnNewTableClick"
                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TablesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="删除" Width="60" Height="26"
                                        Padding="0" Margin="8,0,0,0"
                                        Click="OnDeleteClick" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="80" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
