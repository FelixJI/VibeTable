<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Brand\VibeTable.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms available for NotifyIcon without globally importing its
         UI namespace into the WPF application. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeTable.Contracts\VibeTable.Contracts.csproj" />
    <ProjectReference Include="..\VibeTable.Infrastructure\VibeTable.Infrastructure.csproj" />
    <ProjectReference Include="..\VibeTable.PreviewHost\VibeTable.PreviewHost.csproj" />
    <ProjectReference Include="..\VibeTable.Workspace\VibeTable.Workspace.csproj" />
    <ProjectReference Include="..\VibeTable.DocumentDiff.OpenXml\VibeTable.DocumentDiff.OpenXml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VibeTable.Desktop.Tests" />
    <InternalsVisibleTo Include="VibeTable.PreviewHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\VibeTable.png" />
    <Resource Include="Assets\Brand\VibeTable.png" />
    <None Remove="Assets\Brand\VibeTable.ico" />
    <Resource Include="Assets\Brand\VibeTable.ico" />
    <Content Include="..\..\..\contracts\v2\provider-support.json"
             Link="contracts\v2\provider-support.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\..\contracts\v2\workspace-rpc-capability-manifest.json"
                      LogicalName="VibeTable.Desktop.workspace-rpc-capability-manifest.json" />
  </ItemGroup>

  <Target Name="CopyPreviewHostOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PreviewHostOutput Include="$(MSBuildProjectDirectory)\..\VibeTable.PreviewHost\bin\$(Configuration)\$(TargetFramework)\VibeTable.PreviewHost.*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)PreviewHost" />
    <Copy SourceFiles="@(_PreviewHostOutput)"
          DestinationFolder="$(TargetDir)PreviewHost"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
