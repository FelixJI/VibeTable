<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeTable.Contracts\VibeTable.Contracts.csproj" />
    <ProjectReference Include="..\VibeTable.Infrastructure\VibeTable.Infrastructure.csproj" />
    <ProjectReference Include="..\VibeTable.PreviewHost\VibeTable.PreviewHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VibeTable.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Brand\VibeTable.png" />
    <Resource Include="Assets\Brand\VibeTable.png" />
    <Content Include="..\..\..\contracts\v2\provider-support.json"
             Link="contracts\v2\provider-support.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPreviewHostOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PreviewHostOutput Include="$(MSBuildProjectDirectory)\..\VibeTable.PreviewHost\bin\$(Configuration)\$(TargetFramework)\VibeTable.PreviewHost.*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)PreviewHost" />
    <Copy SourceFiles="@(_PreviewHostOutput)"
          DestinationFolder="$(TargetDir)PreviewHost"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
