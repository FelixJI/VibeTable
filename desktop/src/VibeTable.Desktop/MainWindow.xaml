<Window x:Class="VibeTable.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:VibeTable.Desktop.ViewModels"
        xmlns:local="clr-namespace:VibeTable.Desktop"
        mc:Ignorable="d"
        Title="VibeTable"
        Height="720" Width="1024"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="#FFFFFF">
        <!-- The primary app renderer is never navigated away from or removed. -->
        <wv2:WebView2
            x:Name="AppWebView"
            Visibility="{Binding IsWebViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Lazy, host-owned Directus surface. Hiding it preserves both WebViews. -->
        <Grid x:Name="AdminSurface" Panel.ZIndex="20" Visibility="Collapsed" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F7F8FA" BorderBrush="#E5E6EB" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="18" Height="28" Padding="0" Margin="0,0,3,0"
                                Background="Transparent" BorderThickness="0"
                                Click="OnCloseAdminClick" ToolTip="关闭管理后台"
                                ToolTipService.InitialShowDelay="450">
                            <Ellipse Width="10" Height="10" Fill="#FF5F57"/>
                        </Button>
                        <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="3,0" IsHitTestVisible="False"/>
                        <Ellipse Width="10" Height="10" Fill="#28C840" Margin="3,0,10,0" IsHitTestVisible="False"/>
                    </StackPanel>

                    <Button Grid.Column="1" Height="28" Padding="8,0" Margin="0,0,12,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#1F2329" FontSize="12"
                            Content="返回 VibeTable" Click="OnCloseAdminClick"/>

                    <Border Grid.Column="2" Height="28" MaxWidth="420" Padding="12,0"
                            HorizontalAlignment="Center" Background="#FFFFFF"
                            BorderBrush="#DEE0E3" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▣" Foreground="#646A73" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="本地管理后台 · Directus" Foreground="#4E5969" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="30" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                Content="↻" FontSize="17" Foreground="#4E5969"
                                Click="OnReloadAdminClick" ToolTip="重新载入管理后台"
                                ToolTipService.InitialShowDelay="450"/>
                        <Button Width="30" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                Content="⋯" FontSize="18" Foreground="#4E5969" ToolTip="更多"
                                ToolTipService.InitialShowDelay="450" Click="OnAdminMoreClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重新载入" Click="OnReloadAdminClick"/>
                                    <Separator/>
                                    <MenuItem Header="返回 VibeTable" Click="OnCloseAdminClick"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="DirectusWebView" Grid.Row="1"/>

            <Grid x:Name="AdminLoadingOverlay" Grid.Row="1" Background="#FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="3" IsIndeterminate="True" Foreground="#3370FF"/>
                    <TextBlock Text="正在打开本地管理后台…" Margin="0,16,0,0"
                               Foreground="#646A73" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="AdminErrorOverlay" Grid.Row="1" Background="#FFFFFF" Visibility="Collapsed">
                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="管理后台暂时不可用" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1F2329" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AdminErrorText" Margin="0,10,0,20" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="#646A73" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="返回 VibeTable" Padding="14,6" Margin="0,0,8,0"
                                Click="OnCloseAdminClick"/>
                        <Button Content="重试" Padding="14,6" Background="#3370FF" Foreground="White"
                                BorderBrush="#3370FF" Click="OnRetryAdminClick"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="AdminCloseConfirmOverlay" Grid.Row="1" Panel.ZIndex="30"
                  Background="#66000000" Visibility="Collapsed">
                <Border Width="360" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#FFFFFF" BorderBrush="#E5E6EB" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="返回 VibeTable？" FontSize="17" FontWeight="SemiBold" Foreground="#1F2329"/>
                        <TextBlock Text="请先确认 Directus 中的编辑已保存。关闭后台不会关闭 VibeTable 当前表格。"
                                   Margin="0,8,0,20" TextWrapping="Wrap" Foreground="#646A73" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="继续编辑" Padding="13,6" Margin="0,0,8,0" Click="OnCancelAdminCloseClick"/>
                            <Button Content="返回 VibeTable" Padding="13,6" Background="#3370FF" Foreground="White"
                                    BorderBrush="#3370FF" Click="OnConfirmAdminCloseClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Host fallback exists only while bootstrapping or after a fatal fault. -->
        <Grid Panel.ZIndex="30" Background="#F7F8FA">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:StartupState.Ready}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="44" Height="44" Background="#3370FF" CornerRadius="10" HorizontalAlignment="Center">
                    <TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding StatusText}" Margin="0,18,0,0" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1F2329" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DetailMessage}" Margin="0,8,0,0" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="#646A73"/>
                <ProgressBar Height="3" Width="200" Margin="0,22,0,0" IsIndeterminate="True" Foreground="#3370FF">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static local:StartupState.Faulted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <Button Content="重试" Margin="0,22,0,0" Padding="18,7"
                        HorizontalAlignment="Center" Command="{Binding RetryCommand}"
                        Visibility="{Binding IsRetryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
