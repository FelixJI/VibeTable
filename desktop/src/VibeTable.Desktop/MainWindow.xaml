<Window x:Class="VibeTable.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:VibeTable.Desktop.ViewModels"
        xmlns:local="clr-namespace:VibeTable.Desktop"
        mc:Ignorable="d"
        Title="VibeTable"
        Icon="Assets/Brand/VibeTable.ico"
        Height="720" Width="1024"
        Background="{DynamicResource VtWindowBackgroundBrush}"
        Foreground="{DynamicResource VtWindowTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{DynamicResource VtWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--
            #482 native host chrome: an always-reachable row that no plugin DOM,
            overlay or frozen renderer can shadow. 插件 chrome (停止插件/返回平台/
            管理插件) only renders while a plugin surface is actually active;
            恢复界面 stays reachable from the first renderer load onward — a
            frozen renderer keeps State=Ready but cannot shadow this row, and
            abnormal states (Faulted) still expose the native recovery path.
        -->
        <Border Grid.Row="0" Padding="10,4" BorderBrush="{DynamicResource VtSurfaceBorderBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource VtSurfaceBackgroundBrush}">
            <StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="VibeTable 宿主" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource VtWindowTextBrush}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource VtMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.AutomationId="plugin-stop" Content="停止插件" Margin="4,0" Padding="10,3" FontSize="12"
                            Visibility="{Binding IsPluginChromeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding StopPluginsCommand}"/>
                    <Button AutomationProperties.AutomationId="plugin-return" Content="返回平台" Margin="4,0" Padding="10,3" FontSize="12"
                            Visibility="{Binding IsPluginChromeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ReturnToPlatformCommand}"/>
                    <Button AutomationProperties.AutomationId="plugin-manage" Content="管理插件" Margin="4,0" Padding="10,3" FontSize="12"
                            Visibility="{Binding IsPluginChromeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ManagePluginsCommand}"/>
                    <Button AutomationProperties.AutomationId="plugin-recover" Content="恢复界面" Margin="4,0" Padding="10,3" FontSize="12"
                            Visibility="{Binding IsNativeRecoveryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding RecoverRendererCommand}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding RendererRecoveryError}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource VtWindowTextBrush}" AutomationProperties.AutomationId="renderer-recovery-error">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RendererRecoveryError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </StackPanel>
        </Border>
        <!-- The primary app renderer is never navigated away from; recovery
             rebuilds the whole control in this row (same env/UDF, new generation). -->
        <wv2:WebView2
            x:Name="AppWebView"
            Grid.Row="1"
            AllowExternalDrop="True"
            Visibility="{Binding IsWebViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Host fallback exists only before the shell loads or after a renderer fault;
             it never covers the native chrome row above. -->
        <Grid Grid.Row="1" Panel.ZIndex="30" Background="{DynamicResource VtSurfaceBackgroundBrush}"
              Visibility="{Binding IsHostFallbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="44" Height="44" Background="#3370FF" CornerRadius="10" HorizontalAlignment="Center">
                    <TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding StatusText}" Margin="0,18,0,0" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource VtWindowTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DetailMessage}" Margin="0,8,0,0" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource VtMutedTextBrush}"/>
                <ProgressBar Height="3" Width="200" Margin="0,22,0,0" IsIndeterminate="True" Foreground="#3370FF">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static local:StartupState.Faulted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <Button Content="重试" Margin="0,22,0,0" Padding="18,7"
                        HorizontalAlignment="Center" Command="{Binding RetryCommand}"
                        Visibility="{Binding IsRetryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
