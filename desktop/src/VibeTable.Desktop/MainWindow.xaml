<Window x:Class="VibeTable.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:VibeTable.Desktop.ViewModels"
        xmlns:local="clr-namespace:VibeTable.Desktop"
        mc:Ignorable="d"
        Title="VibeTable"
        Icon="Assets/Brand/VibeTable.ico"
        Height="720" Width="1024"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="#FFFFFF">
        <!-- The primary app renderer is never navigated away from or removed. -->
        <wv2:WebView2
            x:Name="AppWebView"
            AllowExternalDrop="True"
            Visibility="{Binding IsWebViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Host fallback exists only while bootstrapping or after a fatal fault. -->
        <Grid Panel.ZIndex="30" Background="#F7F8FA"
              Visibility="{Binding IsHostFallbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="44" Height="44" Background="#3370FF" CornerRadius="10" HorizontalAlignment="Center">
                    <TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding StatusText}" Margin="0,18,0,0" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1F2329" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DetailMessage}" Margin="0,8,0,0" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="#646A73"/>
                <ProgressBar Height="3" Width="200" Margin="0,22,0,0" IsIndeterminate="True" Foreground="#3370FF">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static local:StartupState.Faulted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <Button Content="重试" Margin="0,22,0,0" Padding="18,7"
                        HorizontalAlignment="Center" Command="{Binding RetryCommand}"
                        Visibility="{Binding IsRetryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
