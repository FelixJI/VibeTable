{
  "$schema": "vibetable.plugin-manifest.v2",
  "pluginId": "com.vibetable.e2e.mutation-boundary",
  "version": "1.0.0",
  "displayName": {
    "zh-CN": "E2E 无 Worker 变更边界"
  },
  "compatibility": {
    "minHostVersion": "0.5.3",
    "pluginApi": "3.x"
  },
  "permissions": {
    "data": [
      {
        "collection": "$active",
        "operations": [
          "read",
          "query",
          "create",
          "update"
        ],
        "fields": []
      }
    ],
    "files": [
      "pickRead",
      "pickWrite"
    ],
    "privateStorage": true,
    "network": {
      "domains": [],
      "methods": []
    }
  },
  "actions": [
    {
      "actionId": "open-boundary",
      "displayName": {
        "zh-CN": "打开真实变更与文件验证"
      },
      "mode": "local",
      "risk": "write",
      "invocation": "manual",
      "placements": [
        "table.toolbar"
      ]
    }
  ],
  "ui": {
    "customViews": [
      {
        "viewId": "boundary",
        "actionId": "open-boundary",
        "entry": "ui/index.html",
        "script": "dist/boundary.js"
      }
    ]
  }
}
