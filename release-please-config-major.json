{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore(main): release ${version}",
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "package-name": "vibetable",
      "versioning-strategy": "always-bump-major",
      "skip-changelog": true,
      "extra-files": [
        { "type": "generic", "path": "backend/_version.py" },
        {
          "type": "json",
          "path": "desktop/publish-layout.json",
          "jsonpath": "$.components.host.version"
        },
        {
          "type": "json",
          "path": "desktop/publish-layout.json",
          "jsonpath": "$.components.backend.version"
        },
        {
          "type": "json",
          "path": "desktop/publish-layout.json",
          "jsonpath": "$.components.web.version"
        },
        {
          "type": "json",
          "path": "desktop/publish-layout.json",
          "jsonpath": "$.components.sidecar.version"
        }
      ]
    }
  }
}
