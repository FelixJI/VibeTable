      "release.sbom.v1",
      "release.workspace-snapshot-v2",
      "release.recovery-tools.v2",
      "release.contract-corpus.v2",
      "release.fault-matrix.v2"
    ],
    "DELETE": [
      "provider.legacy-runtime.absent.v1",
      "collaboration.ui.absent.v1",
      "legacy.backup.absent.v2",
      "legacy.scheme-main-adoption.absent.v2",
      "legacy.global-data-root.absent.v2"
    ]
  },
