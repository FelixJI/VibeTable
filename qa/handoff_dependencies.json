      "contracts/v2/fixtures/file-document.json",
      "contracts/v2/fixtures/retention-policy.json",
      "contracts/v2/fixtures/snapshot-catalog-entry.json"
    ],
    "RELEASE": [
      "desktop/publish-layout.json",
      "desktop/web-grid/src/generated/changelog.json",
      "contracts/v2/compatibility-corpus.json",
      "contracts/v2/negative-fixtures.json",
      "contracts/v2/provider-support.json",
