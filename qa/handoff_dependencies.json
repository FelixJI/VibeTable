{
  "version": 2,
  "description": "Workspace/snapshot v2 delivery sequence and release evidence consumed by qa/handoff.py.",
  "sequence": [
    "CONTRACT",
    "SIDECAR",
    "DESKTOP",
    "PRODUCT",
    "RELEASE",
    "DELETE"
  ],
  "protocolVersion": "2.0",
  "gateSummaryMaxAgeSeconds": 86400,
  "requiredGateStages": [
    "version",
    "package",
    "go-fmt",
    "go-vet",
    "go-test",
    "go-race",
    "go-build",
    "sidecar-smoke",
    "upgrade-smoke",
    "dev-build",
    "python",
    "contracts",
    "tooling",
    "dotnet",
    "web-test",
    "web-build",
    "fault-injection",
    "product-e2e",
    "smoke"
  ],
  "releaseIdentityInputs": [
    "backend",
    "contracts",
    "desktop/src",
    "desktop/tests",
    "desktop/web-grid",
    "CHANGELOG.md",
    "docs/RECOVERY.md",
    "desktop/Directory.Build.props",
    "desktop/publish-layout.json",
    "desktop/VibeTable.Desktop.sln",
    "qa",
    "scripts",
    "sidecar/cmd",
    "sidecar/internal",
    "sidecar/migrations",
    "sidecar/tests",
    "sidecar/go.mod",
    "sidecar/go.sum",
    "tests",
    "tools/recovery-tools",
    "tools/workspace-storage-dependencies.json",
    "global.json",
    "pyproject.toml",
    "uv.lock"
  ],
  "releaseIdentityExcludedDirectories": [
    ".cache",
    ".codex-go-cache",
    ".codex-test-tmp",
    ".idea",
    ".pytest_cache",
    ".vite",
    "__pycache__",
    "bin",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "obj",
    "TestResults"
  ],
  "releaseIdentityExtensions": [
    ".bat",
    ".cjs",
    ".cs",
    ".csproj",
    ".css",
    ".go",
    ".html",
    ".ico",
    ".ini",
    ".js",
    ".json",
    ".jpeg",
    ".jpg",
    ".lock",
    ".md",
    ".mjs",
    ".mod",
    ".png",
    ".props",
    ".ps1",
    ".py",
    ".sh",
    ".sln",
    ".sum",
    ".svg",
    ".targets",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".vue",
    ".webp",
    ".xaml",
    ".yaml",
    ".yml"
