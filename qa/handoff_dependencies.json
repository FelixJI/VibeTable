{
  "version": 2,
  "description": "PocketBase-only delivery sequence and product evidence consumed by qa/handoff.py.",
  "sequence": [
    "CONTRACT",
    "SIDECAR",
    "DESKTOP",
    "PRODUCT",
    "RELEASE",
    "DELETE"
  ],
  "protocolVersion": "2.0",
  "gateSummaryMaxAgeSeconds": 86400,
  "requiredGateStages": [
    "version",
    "package",
    "go-fmt",
    "go-vet",
    "go-test",
    "go-race",
    "go-build",
    "sidecar-smoke",
    "upgrade-smoke",
    "dev-build",
    "python",
    "contracts",
    "tooling",
    "dotnet",
    "web-test",
    "web-build",
    "fault-injection",
    "product-e2e",
    "smoke"
  ],
  "releaseIdentityInputs": [
    "backend",
    "contracts",
    "desktop/src",
    "desktop/tests",
    "desktop/web-grid",
    "CHANGELOG.md",
    "desktop/Directory.Build.props",
    "desktop/publish-layout.json",
    "desktop/VibeTable.Desktop.sln",
    "qa",
    "scripts",
    "sidecar/cmd",
    "sidecar/internal",
    "sidecar/migrations",
    "sidecar/tests",
    "sidecar/go.mod",
    "sidecar/go.sum",
    "tests",
    "global.json",
    "pyproject.toml",
    "uv.lock"
  ],
  "releaseIdentityExcludedDirectories": [
    ".cache",
    ".codex-go-cache",
    ".codex-test-tmp",
    ".idea",
    ".pytest_cache",
    ".vite",
    "__pycache__",
    "bin",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "obj",
    "TestResults"
  ],
  "releaseIdentityExtensions": [
    ".bat",
    ".cjs",
    ".cs",
    ".csproj",
    ".css",
    ".go",
    ".html",
    ".ico",
    ".ini",
    ".js",
    ".json",
    ".jpeg",
    ".jpg",
    ".lock",
    ".md",
    ".mjs",
    ".mod",
    ".png",
    ".props",
    ".ps1",
    ".py",
    ".sh",
    ".sln",
    ".sum",
    ".svg",
    ".targets",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".vue",
    ".webp",
    ".xaml",
    ".yaml",
    ".yml"
  ],
  "capabilities": {
    "CONTRACT": [
      "product.contract.v1",
      "product.error.v1",
      "mutation.receipt.v1"
    ],
    "SIDECAR": [
      "sidecar.health.v1",
      "sidecar.session.v1",
      "schema.catalog.v1",
      "query.port.v1",
      "mutation.kernel.v1",
      "realtime.data-changed.v1"
    ],
    "DESKTOP": [
      "sidecar.supervisor.v1",
      "sidecar.offline-launch.v1",
      "product.rpc-gateway.v1"
    ],
    "PRODUCT": [
      "formula.cel-v1",
      "audit.restore.v1",
      "managed-attachments.v1",
      "relation.lookup.v1",
      "plugin.local-worker.v1"
    ],
    "RELEASE": [
      "release.sidecar-hash.v1",
      "release.migration-hash.v1",
      "release.sbom.v1",
      "release.backup-restore.v1"
    ],
    "DELETE": [
      "provider.legacy-runtime.absent.v1",
      "automation.compatibility.absent.v1",
      "collaboration.ui.absent.v1"
    ]
  },
  "artifactFiles": {
    "sidecar": [
      "sidecar/go.mod",
      "sidecar/go.sum",
      "sidecar/migrations/manifest.json"
    ],
    "schema": [
      "contracts/v1/contracts.schema.json"
    ],
    "migrations": [
      "sidecar/migrations/manifest.json",
      "sidecar/migrations/2026072401_bootstrap.go",
      "sidecar/migrations/2026072402_internal_collections.go",
      "sidecar/migrations/2026072403_internal_metadata_channel.go",
      "sidecar/migrations/2026072404_realtime_outbox_retention.go"
    ],
    "capabilities": [
      "sidecar/internal/schema/capabilities.go",
      "contracts/v1/README.md",
      "qa/handoff_dependencies.json"
    ]
  },
  "artifactPatterns": {
    "sidecar": [
      "sidecar/**/*.go"
    ]
  },
  "fixtures": {
    "CONTRACT": [
      "contracts/v1/fixtures/table-definition.json",
      "contracts/v1/fixtures/mutation-request.json",
      "contracts/v1/fixtures/mutation-receipt.json",
      "contracts/v1/fixtures/product-error.json"
    ],
    "SIDECAR": [
      "sidecar/migrations/manifest.json"
    ],
    "DESKTOP": [],
    "PRODUCT": [
      "contracts/v1/fixtures/data-changed-event.json",
      "contracts/v1/fixtures/managed-attachment-ref.json"
    ],
    "RELEASE": [
      "desktop/publish-layout.json",
      "desktop/web-grid/src/generated/changelog.json",
      "CHANGELOG.md"
    ],
    "DELETE": []
  }
}
