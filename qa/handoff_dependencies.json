    "SIDECAR": [
      "sidecar.health.v1",
      "sidecar.session.v1",
      "schema.catalog.v1",
      "query.port.v1",
      "mutation.kernel.v1",
      "realtime.data-changed.v1",
      "workspace.runtime.v2",
      "workspace.write-coordinator.v2",
      "snapshot.repository.v2",
      "file-history.revision-tree.v2"
    ],
    "DESKTOP": [
      "sidecar.supervisor.v1",
      "sidecar.offline-launch.v1",
      "product.rpc-gateway.v1",
      "workspace.session.v2",
      "workspace.path-grant.v2",
