# Local Directus 12 runtime configuration (VibeTable development / smoke testing).
#
# Copy to ".env" (already gitignored) and fill in real values. `run.py` will
# auto-generate KEY/SECRET on first start if they are still placeholders, so
# you normally only need to set ADMIN_EMAIL / ADMIN_PASSWORD.
#
# This file intentionally uses SQLite so the local instance needs no Docker and
# no external database server — matching the intended runtime-distribution form.

# HTTP port the local Directus listens on. High ephemeral range to avoid
# clashes with registered services. The VibeTable client connects via
# VIBETABLE_DIRECTUS_URL=http://127.0.0.1:${PORT}
HOST=127.0.0.1
PORT=49152

# Instance key/secret. Leave as __GENERATE__ to have run.py create random
# values on first start and persist them into .env. Never commit real secrets.
KEY=__GENERATE__
SECRET=__GENERATE__

# Shared only with the local VibeTable backend. It signs short-lived restore
# preview proofs so authenticated Directus clients cannot mint restore tokens.
VIBETABLE_HISTORY_PROOF_SECRET=__GENERATE__

# Initial administrator account created on first boot. Must pass Joi's strict
# email check, which requires a routable TLD (.com/.org/.io — NOT .local,
# .localhost, .test, .example, which Joi rejects). This is a local-only dev
# account; change it before exposing the instance beyond this workstation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__GENERATE__

# SQLite database. A single local file under ./data (gitignored).
DB_CLIENT=sqlite3
DB_FILENAME=./data/directus.sqlite

# Realtime / WebSocket (VibeTable uses the auth-handshake mode).
WEBSOCKETS_ENABLED=true

# Local file storage root for Directus Files (gitignored).
STORAGE_LOCAL_ROOT=./uploads

# Keep the admin app available so Data Studio can be used for inspection.
ADMIN_ENABLED=true

# Session cookie tuning for the host-injected admin auto-login. The host
# performs /auth/login(mode=session) and injects the resulting cookie into
# the WebView2 cookie jar before navigating to /admin/.
SESSION_COOKIE_TTL=7d
SESSION_COOKIE_SAME_SITE=lax
