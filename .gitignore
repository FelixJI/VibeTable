# .NET and new WebView frontend
node_modules/
# Bundled Node ships its own node_modules/. Only the npm package is part of the
# runtime (needed at first launch); the corepack package is materialized lazily
# by the bundled corepack launcher, so exclude it rather than re-including the
# whole directory (the broad `!runtime/node/node_modules/` let corepack slip in).
!runtime/node/node_modules/npm/
!runtime/node/node_modules/npm/**
desktop/**/bin/
desktop/**/obj/
desktop/web-grid/node_modules/
desktop/web-grid/dist/
TestResults/

# Git worktrees
.worktrees/

# scripts/local_directus — runtime-introduced Directus 12 instance
# (the package.json/.env.template/README are committed; everything else is local)
scripts/local_directus/.env
scripts/local_directus/.npm-cache/
scripts/local_directus/.npm-prefix/
scripts/local_directus/.npmrc.user
scripts/local_directus/.npmrc.global
scripts/local_directus/node_modules/
scripts/local_directus/data/
scripts/local_directus/uploads/
scripts/local_directus/extensions/
scripts/local_directus/.schema-applied
scripts/local_directus/.bootstrapped
scripts/local_directus/.install-verified
scripts/local_directus/.vibetable-initialized
scripts/local_directus/.first-run-backups/
scripts/local_directus/.integration/

