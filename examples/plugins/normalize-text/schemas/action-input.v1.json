{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "field",
    "strategy"
  ],
  "properties": {
    "field": {
      "type": "string"
    },
    "strategy": {
      "enum": [
        "trim",
        "collapse-whitespace",
        "lowercase",
        "uppercase"
      ]
    }
  },
  "additionalProperties": false
}
