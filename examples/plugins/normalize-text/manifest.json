{
  "$schema": "vibetable.plugin-manifest.v2",
  "pluginId": "com.vibetable.examples.normalize-text",
  "version": "1.0.0",
  "displayName": {
    "zh-CN": "批量文本规范化",
    "en": "Normalize text"
  },
  "description": {
    "zh-CN": "无界面动作：对选中记录的可写文本字段做空白规范化，经宿主原生确认后一次提交"
  },
  "compatibility": {
    "minHostVersion": "0.5.3",
    "pluginApi": "3.x"
  },
  "permissions": {
    "data": [
      {
        "collection": "$active",
        "operations": [
          "read",
          "query",
          "update"
        ],
        "fields": [
          "*"
        ]
      }
    ],
    "files": [],
    "privateStorage": false,
    "network": {
      "domains": [],
      "methods": []
    }
  },
  "actions": [
    {
      "actionId": "normalize-selection",
      "displayName": {
        "zh-CN": "规范化选中文本"
      },
      "mode": "local",
      "risk": "write",
      "invocation": "manual",
      "placements": [
        "table.toolbar",
        "table.context-menu"
      ],
      "requires": {
        "selection": "one-or-more"
      },
      "presentation": "headless",
      "entry": "ui/normalize.js"
    }
  ],
  "ui": {
    "customViews": []
  }
}
