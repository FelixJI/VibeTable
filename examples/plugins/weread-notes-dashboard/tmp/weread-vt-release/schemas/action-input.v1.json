{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection"],
  "properties": {
    "collection": { "type": "string" },
    "bookTitleField": { "type": "string", "default": "book_title" },
    "authorField": { "type": "string", "default": "author" },
    "categoryField": { "type": "string", "default": "category" },
    "progressField": { "type": "string", "default": "read_progress" },
    "readMinutesField": { "type": "string", "default": "read_minutes" },
    "noteTextField": { "type": "string", "default": "note" },
    "noteCountField": { "type": "string", "default": "note_count" },
    "noteCreatedAtField": { "type": "string", "default": "note_created_at" },
    "annotationTypeField": { "type": "string", "default": "note_type" },
    "chapterField": { "type": "string", "default": "chapter" },
    "locationField": { "type": "string", "default": "location" },
    "highlightColorField": { "type": "string", "default": "highlight_color" },
    "quoteField": { "type": "string", "default": "quote" }
    ,
    "startDate": {
      "type": "string",
      "description": "可选，支持 YYYY-MM-DD 或可解析日期字符串（如 2026-07-01 或 2026-07-01T00:00:00）。当未填写时不启用起始过滤。"
    },
    "endDate": {
      "type": "string",
      "description": "可选，支持 YYYY-MM-DD 或可解析日期字符串（如 2026-07-01 或 2026-07-01T23:59:59）。当未填写时不启用结束过滤。"
    }
  }
}
