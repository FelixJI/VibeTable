{
  "$schema": "vibetable.plugin-manifest.v2",
  "pluginId": "com.vibetable.examples.data-overview",
  "version": "1.0.0",
  "displayName": {
    "zh-CN": "数据概览面板",
    "en": "Data overview"
  },
  "description": {
    "zh-CN": "通过统一 surface API 读取授权元数据并分页汇总当前数据表"
  },
  "compatibility": {
    "minHostVersion": "0.5.3",
    "pluginApi": "3.x"
  },
  "permissions": {
    "data": [
      {
        "collection": "$active",
        "operations": [
          "read",
          "query"
        ],
        "fields": [
          "*"
        ]
      }
    ],
    "files": [],
    "privateStorage": false,
    "network": {
      "domains": [],
      "methods": []
    }
  },
  "actions": [
    {
      "actionId": "open-overview",
      "displayName": {
        "zh-CN": "打开数据概览"
      },
      "mode": "local",
      "risk": "read",
      "invocation": "manual",
      "placements": [
        "table.toolbar"
      ]
    }
  ],
  "ui": {
    "customViews": [
      {
        "viewId": "overview",
        "actionId": "open-overview",
        "displayName": {
          "zh-CN": "数据概览"
        },
        "entry": "ui/index.html",
        "script": "dist/surface.js"
      }
    ]
  }
}
