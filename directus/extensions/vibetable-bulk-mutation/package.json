{
  "name": "vibetable-bulk-mutation",
  "version": "1.0.0",
  "description": "VibeTable atomic batch-mutation endpoint (vibetable-bulk-mutation.v1). Applies create/update operations in a single transaction with idempotency-key deduplication.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "test": "node --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.0.0",
    "hidden": false
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^18.0.1",
    "@directus/types": "^16.0.0",
    "typescript": "^5.9.3"
  }
}
