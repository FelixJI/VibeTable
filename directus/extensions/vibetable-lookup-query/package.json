{
  "name": "vibetable-lookup-query",
  "version": "1.0.0",
  "description": "Permission-aware VibeTable lookup query endpoint (vibetable-lookup-query.v1).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "test": "node --test src/__tests__/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-exclude=src/__tests__/** --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=75 src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.1.1",
    "hidden": false
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^18.0.1",
    "typescript": "^5.9.3"
  }
}
